title                    = DPPC+MMC Energy Minimization
integrator               = steep
nsteps                   = 50000
emtol                    = 100.0
emstep                   = 0.01

cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
vdw-type                 = Cut-off
rvdw                     = 1.2
pbc                      = xyz
DispCorr                 = EnerPres

constraints              = h-bonds
constraint_algorithm     = lincs
lincs_order              = 4
lincs_iter               = 1

nstenergy                = 500
nstlog                   = 500
