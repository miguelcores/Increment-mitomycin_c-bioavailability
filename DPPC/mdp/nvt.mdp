; NVT equilibration at 325 K
integrator               = md
dt                       = 0.002
nsteps                   = 125000

nstxout                  = 0
nstvout                  = 0
nstenergy                = 5000
nstlog                   = 5000
nstxout-compressed       = 5000

continuation             = no
constraint_algorithm     = lincs
constraints              = all-bonds
lincs_iter               = 1
lincs_order              = 4

cutoff-scheme            = Verlet
ns_type                  = grid
nstlist                  = 10
rcoulomb                 = 1.2
rvdw                     = 1.2

coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.16

tcoupl                   = V-rescale
tc-grps                  = DPPC X2IT SOL
tau_t                    = 0.1 0.1 0.1
ref_t                    = 325 325 325

pcoupl                   = no

pbc                      = xyz
DispCorr                 = EnerPres

gen_vel                  = yes
gen_temp                 = 325
gen_seed                 = -1
