title                    = DPPC+MMC NPT 325K 1bar
integrator               = md
dt                       = 0.002
nsteps                   = 1000000   ; 2 ns

continuation             = yes
gen_vel                  = no

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
vdw-type                 = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres
pbc                      = xyz

tcoupl                   = Nose-Hoover
tc-grps                  = DPPC MMC SOL
tau_t                    = 0.5 0.5 0.5
ref_t                    = 325 325 325

pcoupl                   = Parrinello-Rahman
pcoupltype               = semiisotropic
tau_p                    = 2.0
ref_p                    = 1.0 1.0
compressibility          = 4.5e-5 4.5e-5

constraints              = all-bonds
constraint_algorithm     = lincs
lincs_order              = 4
lincs_iter               = 1

nstxout-compressed       = 5000
nstenergy                = 1000
nstlog                   = 1000
