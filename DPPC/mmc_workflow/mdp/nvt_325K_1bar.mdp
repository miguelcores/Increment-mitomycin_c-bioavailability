title                    = DPPC+MMC NVT 325K
integrator               = md
dt                       = 0.002
nsteps                   = 500000    ; 1 ns

continuation             = no
gen_vel                  = yes
gen_temp                 = 325
gen_seed                 = -1

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
vdw-type                 = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres
pbc                      = xyz

tcoupl                   = Nose-Hoover
tc-grps                  = DPPC MMC SOL
tau_t                    = 0.5 0.5 0.5
ref_t                    = 325 325 325

pcoupl                   = no

constraints              = all-bonds
constraint_algorithm     = lincs
lincs_order              = 4
lincs_iter               = 1

nstxout-compressed       = 5000
nstenergy                = 1000
nstlog                   = 1000
