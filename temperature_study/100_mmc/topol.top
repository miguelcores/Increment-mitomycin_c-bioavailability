; Master topology file for 100 MMC molecules
; This file includes all necessary topologies and defines the system composition.

; Include the GROMOS 54A7 force field parameters. 
#include "../../mitomycin_c/gromos54a7_atb.ff/forcefield.itp"

; Include the specific topology file for your molecule.
#include "../../mitomycin_c/mmc.itp"

; Include the water topology (SPC is the standard water model for GROMOS)
#include "../../mitomycin_c/gromos54a7_atb.ff/spc.itp"

; Include topology for standard ions (needed for neutralization later, but good to have)
#include "../../mitomycin_c/gromos54a7_atb.ff/ions.itp"

[ system ]
; Name of the simulation system
100 X2IT Molecules Solvated in SPC Water

[ molecules ]
; Compound    #mols
; IMPORTANT: The molecule name (X2IT) MUST exactly match the name 
; defined under the [ moleculetype ] section in your mmc.itp file.
X2IT          100
SOL          2957
